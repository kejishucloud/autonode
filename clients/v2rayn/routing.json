{
  "domainStrategy": "IPIfNonMatch",
  "rules": [
    {
      "type": "field",
      "domain": ["domain:local", "domain:localhost", "domain:lan", "domain:home.arpa"],
      "outboundTag": "direct"
    },
    {
      "type": "field",
      "ip": ["geoip:private"],
      "outboundTag": "direct"
    },
    {
      "type": "field",
      "domain": [
        "domain:openai.com", "domain:chatgpt.com", "domain:oaistatic.com",
        "domain:oaiusercontent.com", "domain:anthropic.com", "domain:claude.ai",
        "domain:github.com", "domain:githubusercontent.com", "domain:githubassets.com",
        "domain:google.com", "domain:googleapis.com", "domain:googleapis.cn",
        "domain:gstatic.com", "domain:youtube.com", "domain:youtu.be",
        "domain:ytimg.com", "domain:googlevideo.com", "domain:telegram.org", "domain:t.me",
        "domain:discord.com", "domain:x.com", "domain:twitter.com"
      ],
      "outboundTag": "proxy"
    },
    {
      "type": "field",
      "domain": ["geosite:cn"],
      "outboundTag": "direct"
    },
    {
      "type": "field",
      "ip": ["geoip:cn"],
      "outboundTag": "direct"
    }
  ]
}
